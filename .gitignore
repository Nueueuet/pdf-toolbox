# Fetched by `npm run vendor` / `npm run vendor:ai`, not source.
vendor/

# Generated samples for the test suite.
test-files/

# Store packages built by `npm run package`.
dist/

# Machine-specific mirror destination for `npm run package` — a local path, of
# no use to anyone else.
mirror.local.txt

# Scratch directories used while unpacking npm tarballs.
.vendor-tmp/
.ai-tmp/
.package-tmp/

node_modules/
