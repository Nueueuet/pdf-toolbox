{
  "name": "pdf-toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that opens a full PDF editing workspace in a new tab.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/fetch-vendor.mjs",
    "vendor:ai": "node scripts/fetch-ai.mjs",
    "vendor:ocr": "node scripts/fetch-ocr.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test-files": "node scripts/make-test-pdfs.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/check.mjs && node scripts/package.mjs",
    "setup": "npm run vendor && npm run icons && npm run check"
  }
}
